---
// Logo do produto: o nome em Caveat, como na barra superior do portal.
interface Props {
	href: string;
}
const { href } = Astro.props;
---

<a class="wordmark" href={href} translate="no">WebContainerUI</a>

<style>
	.wordmark {
		font-family: var(--wc-font-logo);
		font-weight: 700;
		font-size: 1.75rem;
		line-height: 1;
		letter-spacing: 0.01em;
		color: inherit;
		text-decoration: none;
		white-space: nowrap;
	}
</style>
