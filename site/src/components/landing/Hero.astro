---
import { Image } from 'astro:assets';
import catalog from '../../assets/screenshots/catalog.png';
import { href, type Locale } from '../../lib/paths';

interface Props {
	locale: Locale;
	t: Record<string, string>;
}
const { locale, t } = Astro.props;
---

<section class="hero">
	<div class="wrap">
		<h1>{t.title}</h1>
		<p class="lead">{t.lead}</p>
		<div class="actions">
			<a class="button primary" href={href(locale, 'getting-started/installation')}>{t.primary}</a>
			<a class="button ghost" href={href(locale, 'getting-started/local-trial')}>{t.secondary}</a>
		</div>
		<div class="shot stage">
			<Image src={catalog} alt={t.screenshotAlt} widths={[640, 960, 1440, 1920]} sizes="(min-width: 76rem) 72rem, 94vw" loading="eager" fetchpriority="high" />
		</div>
	</div>
</section>

<style>
	.hero {
		padding-top: clamp(3rem, 8vw, 6.5rem);
		/* A captura avança sobre a seção seguinte. */
		padding-bottom: 0;
	}
	h1 {
		font-size: clamp(2.4rem, 1.1rem + 5.4vw, 5rem);
		letter-spacing: -0.035em;
		max-width: 17ch;
	}
	.lead {
		margin-top: 1.5rem;
		max-width: 60ch;
		font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
		color: var(--wc-muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.25rem;
	}
	.stage {
		margin-top: clamp(3rem, 6vw, 5rem);
		margin-bottom: clamp(-6rem, -8vw, -3rem);
		position: relative;
		z-index: 1;
		/* O único momento animado da página: a interface entra em foco. */
		animation: focus-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
	}
	@keyframes focus-in {
		from {
			opacity: 0.4;
			filter: blur(14px);
			transform: translateY(1.5rem) scale(0.985);
		}
	}
</style>
