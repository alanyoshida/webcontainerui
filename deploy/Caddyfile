# Caddy termina TLS e atua como plano de dados das sessões (change
# external-stream-proxy): as rotas /i/{uuid}/* são importadas de um
# diretório compartilhado, publicado pelo portal, e encaminham direto ao
# container consultando o portal por forward_auth antes de cada requisição.
# O restante (front-end e API) continua indo para o portal.
#
# WebSocket não precisa de diretiva especial: o reverse_proxy do Caddy
# repassa upgrades de conexão por padrão, diferente do Nginx.

{$WCUI_DOMAIN} {
	# HSTS (change harden-login, M1): com o cookie de sessão agora marcado
	# Secure, isto elimina o downgrade para HTTP como vetor de roubo do
	# cookie por um atacante na rede. Sem includeSubdomains/preload:
	# o domínio pode receber outros serviços e HSTS agressivo é difícil
	# de reverter — cada deploy decide se quer ir além.
	header Strict-Transport-Security "max-age=31536000"

	# Remove o cabeçalho Server do uvicorn encaminhado (change
	# http-hardening, I3): a borda não anuncia a stack.
	header -Server

	# O endpoint interno de autorização do plano de dados não é exposto
	# pela borda: só o forward_auth, de dentro da rede, o alcança.
	respond /internal/* 404

	# Uma rota por instância viva, escrita pelo portal no volume
	# compartilhado (caddy_routes). Cada snippet tem um `handle` próprio
	# para /i/{uuid}/* — o Caddy ordena `handle` antes do `reverse_proxy`
	# abaixo, então só o restante cai no portal. Glob vazio não é erro.
	import /etc/caddy/caddy-routes/*.caddy

	reverse_proxy portal:8000 {
		# Sessões de desktop são conexões longas (D1); sem isto, o padrão
		# do Caddy cortaria uma sessão ociosa bem antes dos 3600s que o
		# próprio container do webtop já usa internamente.
		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}
